rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Is the user logged in and has the specific verified email?
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             (request.auth.token.email == "motaem23@gmail.com" || request.auth.token.email == "motaem23y@gmail.com") &&
             request.auth.token.email_verified == true;
    }

    function isBypassAuthorized(data) {
      return data != null && (
        data.get('adminHash', '') == "f8614e5dc45a9376b27e8734b41b67a185444b2c1bbe1cbb83c38217ecc0a580" || 
        data.get('adminHash', '') == "ef1afe13a2bd786629356f83b936c78cccc3683ee172ccd9d78780da63578405" || 
        data.get('adminHash', '') == "0a181d1436cfb77d600affbe036a28f7d7cb1e5c84ae478bf0a8f0c1a63db727"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Projects rules
    match /projects/{projectId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isBypassAuthorized(request.resource.data)) && isValidId(projectId);
      allow delete: if (isAdmin() || isBypassAuthorized(resource.data)) && isValidId(projectId);
    }

    // Skills rules
    match /skills/{skillId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isBypassAuthorized(request.resource.data)) && isValidId(skillId);
      allow delete: if (isAdmin() || isBypassAuthorized(resource.data)) && isValidId(skillId);
    }

    // Services rules
    match /services/{serviceId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isBypassAuthorized(request.resource.data)) && isValidId(serviceId);
      allow delete: if (isAdmin() || isBypassAuthorized(resource.data)) && isValidId(serviceId);
    }

    // Testimonials rules
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isBypassAuthorized(request.resource.data)) && isValidId(testimonialId);
      allow delete: if (isAdmin() || isBypassAuthorized(resource.data)) && isValidId(testimonialId);
    }

    // Social links rules
    match /socialLinks/{socialId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isBypassAuthorized(request.resource.data)) && isValidId(socialId);
      allow delete: if (isAdmin() || isBypassAuthorized(resource.data)) && isValidId(socialId);
    }

    // Texts configurations rules
    match /texts/{textId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isBypassAuthorized(request.resource.data)) && isValidId(textId);
      allow delete: if (isAdmin() || isBypassAuthorized(resource.data)) && isValidId(textId);
    }
  }
}
