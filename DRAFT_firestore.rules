rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Is the user logged in and has the specific verified email?
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
             (request.auth.token.email == "motaem23@gmail.com" || request.auth.token.email == "motaem23y@gmail.com") &&
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Projects rules
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(projectId);
    }

    // Skills rules
    match /skills/{skillId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(skillId);
    }

    // Services rules
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(serviceId);
    }

    // Testimonials rules
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(testimonialId);
    }

    // Social links rules
    match /socialLinks/{socialId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(socialId);
    }

    // Texts configurations rules
    match /texts/{textId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(textId);
    }
  }
}
