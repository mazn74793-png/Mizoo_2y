{
  "entities": {
    "Project": {
      "title": "Project Showcase",
      "description": "Premium project showcases in Mazen's portfolio",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "techStack": { "type": "array" },
        "imageUrl": { "type": "string" },
        "videoUrl": { "type": "string" },
        "liveUrl": { "type": "string" },
        "githubUrl": { "type": "string" },
        "caseStudy": { "type": "string" },
        "order": { "type": "number" },
        "featured": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "description", "techStack", "imageUrl", "order", "featured"]
    },
    "Skill": {
      "title": "Developer Skill",
      "description": "Skills and technologies that Mazen masters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "icon": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "category", "icon", "order"]
    },
    "Service": {
      "title": "Premium Service",
      "description": "Offered development and design services",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "icon": { "type": "string" },
        "features": { "type": "array" },
        "order": { "type": "number" }
      },
      "required": ["id", "title", "description", "icon", "features", "order"]
    },
    "Testimonial": {
      "title": "Luxury Testimonial",
      "description": "Endorsements from top-tier tech leaders and clients",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "company": { "type": "string" },
        "avatar": { "type": "string" },
        "text": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "role", "company", "avatar", "text", "order"]
    },
    "SocialLink": {
      "title": "Social Platform Link",
      "description": "Mazen's verified professional social links",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "platform": { "type": "string" },
        "url": { "type": "string" },
        "icon": { "type": "string" }
      },
      "required": ["id", "platform", "url", "icon"]
    },
    "TextConfig": {
      "title": "Custom Visual Text Config",
      "description": "Configurable portfolio text snippets to manage headers or landing texts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "key": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["id", "key", "value"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Project showcases database collection"
    },
    "/skills/{skillId}": {
      "schema": "Skill",
      "description": "Interactive tech stacks database collection"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "Premium service cards database collection"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Luxury endorsements database collection"
    },
    "/socialLinks/{socialId}": {
      "schema": "SocialLink",
      "description": "Verified social references database collection"
    },
    "/texts/{textId}": {
      "schema": "TextConfig",
      "description": "Visual copy and text snippets database collection"
    }
  }
}
